{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AISENSE",
  "version": "0.1.0",
  "identifier": "app.aisense.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @aisense/desktop dev",
    "beforeBuildCommand": "pnpm --filter @aisense/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "AISENSE",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/jjoaquim0/AISENSE/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Crie times de IA de maneira fácil e gerenciável.",
    "longDescription": "AISENSE monta, opera e coordena equipes de agentes de IA em terminais reais que conversam entre si.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
